# USAJOBS API key (US federal jobs): request one at https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
# The email address the USAJOBS key was requested with; the API requires it as the User-Agent header.
USAJOBS_USER_AGENT=
# Adzuna application id (Canada and US job ads): register at https://developer.adzuna.com/signup
ADZUNA_APP_ID=
# Adzuna application key, issued together with the application id.
ADZUNA_APP_KEY=
# Jooble API key: request one at https://jooble.org/api/about (one key per country site; the free plan allows 500 requests per key in total).
JOOBLE_API_KEY=
