# USAJOBS API key (US federal jobs): request one at https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
# The email address the USAJOBS key was requested with; the API requires it as the User-Agent header.
USAJOBS_USER_AGENT=
# Adzuna application id (Canada and US job ads): register at https://developer.adzuna.com/signup
ADZUNA_APP_ID=
# Adzuna application key, issued together with the application id.
ADZUNA_APP_KEY=
# Jooble API key: request one at https://jooble.org/api/about (one key per country site; the free plan allows 500 requests per key in total).
JOOBLE_API_KEY=
# Vercel: 1 lets cron-ats leave the boards the daily runner (ingest.yml) crawled in the last 20 hours to it; set it only after ingest.yml has completed a run.
INGEST_V2_RUNNER=
# The runner (an ingest.yml secret when it runs there): a Slack-style webhook URL that receives the run's yield warnings; unset, they only reach the log.
ALERT_WEBHOOK_URL=
# Vercel: 1 makes cron-ats store every experience level and crawl the adapter boards; unset, it keeps the student catalogue as before scraper v2. Set it only once the Neon plan has room, after INGEST_V2_RUNNER (docs/ingestion-pipeline.md).
CRON_ATS_V2_CATALOGUE=
