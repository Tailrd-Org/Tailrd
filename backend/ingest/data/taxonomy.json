{
  "_comment": "Rules for backend/ingest/taxonomy.py. Every pattern is a Python regular expression, matched without regard to case; a list of patterns is one alternation. Bump taxonomy.ENRICHMENT_VERSION when a change here should re-tag stored rows.",

  "experience": {
    "_comment": "Read in this order after the entry tier of services/ats_scraper (a named student or new-grad track keeps the label experience_level_for gives it; a level word such as junior, analyst or associate is entry): internship, new_grad, executive, director, lead, senior, mid, entry, then the years the description asks for, then default. The first level whose patterns match wins, except where a pattern below says otherwise.",

    "default": "mid",
    "years_to_level": [[0, "entry"], [2, "mid"], [5, "senior"], [8, "lead"]],

    "boss_phrase": "\\b(?P<role>assistant|aide|advis[eo]r|chief of staff|secretary|partner|liaison|coordinator|specialist|counsel)\\s+to\\s+(?:the\\s+)?[^,;|()\\[\\]&]*",
    "_boss_phrase": "The person a role serves is not its level: 'Executive Assistant to the CEO' is an assistant, 'Chief of Staff to CIO & Head of PMO' keeps its own head-of.",

    "band_words": {
      "junior": "entry", "jr": "entry", "jr.": "entry",
      "intermediate": "mid", "experienced": "mid", "mid-level": "mid", "mid level": "mid",
      "senior": "senior", "sr": "senior", "sr.": "senior",
      "staff": "lead", "lead": "lead", "principal": "lead"
    },
    "_band_words": "A title offering two bands ('Senior/Staff Engineer', 'Experienced or Senior') is open at the lower one, and 'Worker/Senior' at the bare role.",

    "internship": ["\\bsummer (?:associate|analyst)s?\\b", "\\bteaching assistant\\b.*\\b[a-z]{3,4}\\s?\\d{3}\\b"],
    "_internship": "Summer associates and analysts are interns; a teaching assistant for a numbered course is a student job.",

    "new_grad": ["\\b(?:mba|leadership|management|associate|analyst|graduate|career)\\s+development\\s+program\\b(?!\\s+(?:manager|lead|director|coordinator|specialist|partner|advis[eo]r))"],

    "deputy_chief": ["\\b(?:deputy|assistant|associate)\\s+chief\\b"],
    "_deputy_chief": "A deputy to a chief is a director.",

    "executive": [
      "\\bchief\\b(?!\\s+of\\s+staff)[^,;|()]*?\\b(?:officer|executive)\\b",
      "\\b(?:ceo|cfo|coo|cto|cio|cmo|cno|cpo|cro|cdo|clo|cco|cao|cso|cbo|chro|ciso|cxo)\\b(?!\\s+(?:communications?|office|staff|assistant|support|advis[eo]r))",
      "(?<!vice )(?<!vice-)\\bpresident\\b",
      "\\b[es]vp\\b",
      "\\b(?:executive|senior)\\s+vice[- ]president\\b",
      "\\bmanaging partner\\b",
      "\\bprovost\\b",
      "(?<!deputy )(?<!associate )(?<!assistant )\\bgeneral counsel\\b"
    ],
    "_executive": "Chief officers (CEO, CFO and the rest), presidents but not vice presidents, EVP and SVP, a managing partner, a provost, a general counsel. A plain vice president who is also a chief of one business group ('VP, Business Group CISO') is a director.",

    "vice_president": ["(?<!senior )(?<!executive )\\bvice[- ]president\\b", "\\ba?vp\\b"],
    "individual_role": ["\\b(?:engineer|developer|programmer|tester|analyst|scientist|designer|product manager|product owner|architect)s?\\b"],
    "_individual_role": "Banks give individual contributors a vice-president rank: 'Senior Penetration Tester, Vice President' and 'Product Manager - Assistant Vice President' are read without the rank.",

    "director": [
      "\\bdirector\\b",
      "\\bhead of\\b",
      "\\bhead,",
      "\\b(?:global|regional|group)\\s+head\\b",
      "\\bdean\\b(?!'s|\u2019s)",
      "\\b(?:deputy|associate|assistant)\\s+general counsel\\b"
    ],
    "_director": "Director (associate, assistant and senior too), head of, dean, vice president (vice_president above), deputy general counsel.",

    "member_of_staff": "\\bmember of \\w+ staff\\b",
    "group_manager": ["\\bgroup\\s+(?:product\\s+)?manager\\b"],
    "individual_manager": "\\b(?:product|project|program|account|key account|relationship|case|community(?:\\s+engagement)?|social media|content|partner(?:ships)?|partner success|customer success|client success|customer experience|events?|business development|real estate development|property development|portfolio|contracts?|(?:content|product|growth|digital|field|channel|partner|lifecycle|influencer|brand|email|performance|social)\\s+marketing)\\s+manager\\b|\\bgestionnaire de projets?\\b",
    "_individual_manager": "Where Manager lands: these manager titles name an individual contributor's job, so they take their own level words and are mid without one ('Senior Product Manager' is senior, 'Account Manager' mid). Every other manager runs a team or a function and is lead, 'Senior Manager' included.",
    "associate_manager": "\\bassociate\\s+(?:[\\w&/-]+\\s+){0,3}?manager\\b",
    "_associate_manager": "Associate sits one step under the manager it names: an associate individual-contributor manager is entry, an associate manager of a function is mid.",

    "lead": [
      "\\bchief of staff\\b",
      "\\bstaff\\b(?!\\s+(?:accountants?|nurses?|rns?|pharmacists?|physicians?|psychologists?|therapists?|attorneys?|auditors?|assistants?|writers?))",
      "\\blead\\b(?!\\s+generation)",
      "\\bleader\\b",
      "\\bprincipal\\b",
      "(?<!solutions )(?<!solution )\\barchitect\\b",
      "\\bmanager\\b",
      "\\bmgr\\b",
      "\\bgestionnaire\\b",
      "\\bsupervisor\\b",
      "\\bsupv\\b",
      "\\bspvr\\b",
      "\\bsuperintendent\\b",
      "\\bforem[ae]n\\b",
      "\\bdistinguished\\b",
      "\\bcharge nurse\\b",
      "\\b(?:head|executive)\\s+chef\\b"
    ],
    "_lead": "Staff, lead, principal, architect (not a customer-facing solutions architect), manager, supervisor, superintendent, foreman, chief of staff.",

    "senior": [
      "\\bsenior\\b",
      "\\bsr\\b\\.?",
      "\\biii\\b",
      "\\biv\\b(?!\\s+(?:therapy|team|nurse|infusion))",
      "\\b(?:level|lvl|grade)\\s*[3-9]\\b",
      "\\bl[4-9]\\b",
      "\\bsubject matter expert\\b",
      "\\bsme\\b(?!\\s+(?:account|sales|market|segment|business|banking|lending))"
    ],

    "mid": [
      "\\bii\\b(?<!i/ii)(?<!i / ii)(?<!i or ii)",
      "\\b(?:level|lvl|grade)\\s*2\\b",
      "\\bmid[- ]?level\\b",
      "\\bintermediate\\b",
      "\\bexperienced\\b",
      "\\bassociate manager\\b",
      "\\bcounsel\\b"
    ],
    "_mid": "Level II, mid-level words, and a lawyer titled counsel without a senior word (an associate counsel asks for years at the bar).",

    "numeral": "\\b[a-z]{3,}\\.?\\s+(?P<num>iii|ii|iv|i|[1-5])\\b(?=\\s*(?:$|[-,(/|:\u2013\u2014]))",
    "numeral_levels": {"i": "entry", "1": "entry", "ii": "mid", "2": "mid", "iii": "senior", "iv": "senior", "3": "senior", "4": "senior", "5": "senior"},
    "_numeral": "A role's trailing level number: 'Custodian I', 'Laboratory Attendant 2', 'Cook III'.",

    "entry": [
      "\\bstaff (?:accountant|auditor)s?\\b",
      "\\b(?:business|sales|account|market)\\s+development\\s+rep(?:resentative)?s?\\b",
      "\\b[bs]drs?\\b",
      "\\b(?:administrative|admin|office|development|program|clinic|ward)\\s+assistants?\\b",
      "\\breceptionists?\\b",
      "\\bclerks?\\b",
      "\\btellers?\\b"
    ],
    "coordinator": "\\bcoordinators?\\b",
    "clinical_coordinator": "\\b(?:nurse|nursing|clinical|care|rn|patient care)\\s+coordinators?\\b",
    "_entry": "Staff accountants and auditors (the first rung in accounting), development representatives, assistants, clerks, tellers and coordinators (not a nurse coordinator) are entry roles when nothing else sets a level.",

    "frontline": [
      "\\bcashiers?\\b", "\\bhousekeep\\w*", "\\bcustodians?\\b", "\\bjanitor\\w*", "\\bcleaners?\\b",
      "\\baides?\\b", "\\benvironmental services?\\b", "\\bporters?\\b", "\\bdishwashers?\\b",
      "\\bcook'?s helper\\b", "\\bfront desk\\b", "\\bstorekeepers?\\b", "\\bstock(?:er|ers|person)\\b",
      "\\bpickers?\\b", "\\bpackers?\\b", "\\bmaterial handlers?\\b", "\\bcouriers?\\b", "(?<!device )\\bdrivers?\\b",
      "\\bmail\\s?room\\b", "\\blabou?rers?\\b", "\\bgroundskeepers?\\b", "\\bassemblers?\\b",
      "\\b(?:assembly|machine|production|scale|line)\\s+operators?\\b",
      "\\bproduction\\s+(?:associate|worker|technician|operator)s?\\b", "\\bmaintenance\\s+workers?\\b",
      "\\bfood service\\b", "\\bdietary\\b",
      "\\bcustomer\\s+(?:service|experience|care|support)\\s+(?:representative|rep|associate|agent|advocate|specialist)s?\\b",
      "\\bsupport\\s+(?:specialist|representative|agent|advocate|associate)s?\\b",
      "\\bcall cent(?:er|re)\\b", "\\bcrew\\b"
    ],
    "professional": "\\b(?:lecturer|instructor|professor|teacher|tutor|nurse|physician|doctor|therapist|pharmacist|psycholog\\w*|counsel|attorney|lawyer|engineer|developer|programmer|scientist|analyst|accountant|designer|architect|technologist|veterinarian|dietitian|paramedic|researcher|librarian|archivist)s?\\b",
    "_frontline": "Frontline or hourly work with no level word is entry: ats_scraper.FRONTLINE (shifts, part-time, store and warehouse work) and these roles. A professional role is never frontline for its hours alone: a part-time lecturer or a weekend-shift support engineer keeps the default."
  },

  "years": {
    "_comment": "years_required(): the lower bound of the first experience requirement in the text. A figure above max_years is a company's age ('25+ years of experience' in an About Us), not a requirement.",
    "max_years": 20,
    "number_words": {"one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10, "eleven": 11, "twelve": 12, "fifteen": 15, "un": 1, "deux": 2, "trois": 3, "quatre": 4, "cinq": 5},
    "requirement": "(?<![\\d.,$/])(?P<low>\\d{1,2})\\s*(?:\\+|plus)?\\s*(?:(?:-|\u2013|to|or|\u00e0)\\s*(?P<high>\\d{1,2})\\s*\\+?\\s*)?(?:or\\s+more\\s+|\\+\\s*)?(?:years?|yrs?|ans)['\u2019]?(?P<gap>[^.;:!?\\n]{0,60}?)\\b(?:experience|exp\\b|exp\u00e9rience)",
    "not_a_requirement": "\\b(?:age|old|older|ago|in business|history|anniversary)\\b"
  },

  "families": {
    "_comment": "Priority-ordered keyword rules. classify_family reads the title against every rule's 'title' patterns first (a rule with 'if_description' also needs its description to match), then the department against 'department', then the title against 'title_weak', then the first 600 characters of the description against 'description'. The first rule that matches is the primary family; the next family found in the title or department is the secondary. 'other' only when nothing matches, or a rule says the job has no family (custodians, security guards).",
