{
  "name": "applypilot-chrome-extension",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Tailrd Chrome extension: fills the repetitive fields of job applications from your Tailrd profile; you review and submit.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "icons": "node --experimental-strip-types --disable-warning=ExperimentalWarning ../frontend/scripts/brand/build-brand.mjs",
    "test:smoke": "node test/scan-smoke.mjs",
    "test": "vitest run",
    "test:browser": "node test/browser/gen-resume.mjs && node test/browser/build.mjs && node test/browser/run.mjs",
    "test:extension": "node build.mjs && node test/browser/load-extension.mjs",
    "test:flow": "node build.mjs && node test/browser/flow-probe.mjs",
    "test:workday-account": "node build.mjs && node test/browser/workday-account-probe.mjs",
    "test:workday-gate": "node build.mjs && node test/browser/workday-account-gate-probe.mjs",
    "test:workday-churn": "node build.mjs && node test/browser/workday-churn-probe.mjs",
    "test:workday-flow": "node build.mjs && node test/browser/workday-flow-probe.mjs",
    "test:click-shadow": "node test/browser/click-shadow-probe.mjs",
    "test:driver": "node build.mjs && node test/browser/react-select-driver.mjs",
    "preview": "node test/browser/panel-preview.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.61.1",
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "sharp": "^0.35.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
