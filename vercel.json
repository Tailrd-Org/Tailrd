{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https:"
        }
      ]
    }
  ],
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{backend/tests/**,**/test_*.py,**/*.test.py,**/__pycache__/**,**/.pytest_cache/**,match-engine/tests/**,match-engine/eval/**,match-engine/scripts/**,match-engine/proposals/**,match-engine/reports/**,match-engine/docs/**,match-engine/data/raw/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/resumes",
      "destination": "/api/index.py"
    },
    {
      "source": "/resumes/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/ai/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/jobs/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/jobs",
      "destination": "/api/index.py"
    },
    {
      "source": "/settings/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/settings",
      "destination": "/api/index.py"
    },
    {
      "source": "/connections/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/apply/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/autofill/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/github-sources(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth",
      "destination": "/api/index.py"
    },
    {
      "source": "/feedback",
      "destination": "/api/index.py"
    },
    {
      "source": "/feedback/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
